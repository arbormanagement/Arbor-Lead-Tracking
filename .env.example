# ─────────────────────────────────────────────────────────────────────────────
# Arbor Lead Tracking — environment variables
# Copy to .env.local for local dev; set the same keys on the Railway service.
# ─────────────────────────────────────────────────────────────────────────────

# App
APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# Database — pooled URL for the app, unpooled/direct for migrations.
# Works against Neon or Railway Postgres; on Railway, reference the Postgres
# service's variables (e.g. DATABASE_URL=${{Postgres.DATABASE_URL}}) rather than
# pasting a literal URL, so credential rotation doesn't break the deploy.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/arbor?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/arbor?sslmode=require

# Driver: `pg` (default) = long-lived node-postgres pool, right for a persistent
# server. `neon-http` = Neon's stateless HTTPS driver, for serverless/edge hosts or
# networks that block raw Postgres TCP. See lib/db/client.ts.
DB_DRIVER=pg
# Max TCP connections per process. Web + cron worker each open their own pool, so
# keep the sum under the database's connection limit.
DATABASE_POOL_MAX=5

# Auth (NextAuth / Auth.js) — single internal admin
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=justin@arbor-mgmt.com
# bcrypt/argon hash of the admin password (see scripts/hash-password.ts)
ADMIN_PASSWORD_HASH=

# Cookie signing for the first-party tracking cookies (arbor_vid / arbor_sid)
COOKIE_SIGNING_SECRET=change-me-openssl-rand-hex-32

# Root key for envelope-encrypting integration credentials entered in the app
# (Settings → Integrations). Any string; absent → credentials read from env only.
CREDENTIALS_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Twilio — call tracking, DNI, recording
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# API key/secret preferred over auth token for SDK calls
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=
# Default forwarding destination for tracked calls (office line)
TWILIO_DEFAULT_DESTINATION=+16188368004
# Public base for Twilio webhooks, e.g. https://app.arbor-mgmt.com/api/twilio
TWILIO_VOICE_WEBHOOK_BASE=http://localhost:3000/api/twilio

# Deepgram — call transcription
DEEPGRAM_API_KEY=

# Object storage for recordings — unused today (recordings stay on Twilio and are
# streamed through /api/calls/[id]/recording). Left in place for a future move.
BLOB_READ_WRITE_TOKEN=

# ── Read path: DIRECT platform APIs (primary) ──────────────────────────────────
# Decision 2026-06-26: scheduled spend/revenue sync goes direct, not via MCP.

# Platform IDs
FB_AD_ACCOUNT_ID=act_3581389262154764
GOOGLE_ADS_CUSTOMER_ID=8300392986
GA4_PROPERTY_ID=399873230

# HousecallPro (revenue source of truth) — API-key REST
HCP_API_BASE=https://api.housecallpro.com
HCP_API_KEY=

# Google Ads — OAuth2 refresh-token flow + developer token
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Only if calls route through a manager (MCC) account — digits only
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Facebook Marketing API — long-lived access token
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v21.0

# Facebook lead-gen webhook: handshake token (any string we choose) + app secret
# (verifies X-Hub-Signature-256 on inbound events)
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=

# Arbor MCP server — OPTIONAL per-platform fallback for the read path
ARBOR_MCP_URL=https://arbor-mcp.up.railway.app/mcp
ARBOR_MCP_TOKEN=

# ── Scheduled jobs (the `cron` Railway service — scripts/cron.ts) ─────────────
# Shared secret the worker sends as `Authorization: Bearer <CRON_SECRET>` to
# /api/cron/*. Must be IDENTICAL on the web service and the cron worker.
CRON_SECRET=change-me-openssl-rand-hex-32

# Where the worker sends job requests. Defaults to APP_BASE_URL. On Railway,
# prefer the private domain so cron traffic never leaves the project network:
#   CRON_TARGET_BASE_URL=http://${{web.RAILWAY_PRIVATE_DOMAIN}}:8080
# (that requires HOST=:: on the web service — see below).
CRON_TARGET_BASE_URL=

# Timezone the cron patterns are interpreted in. UTC matches the old Vercel Cron
# behavior exactly; America/Chicago would reinterpret them as local time.
CRON_TIMEZONE=UTC

# Optional: run only these jobs in this worker (comma-separated). Empty = all.
CRON_JOBS=

# ── Server binding ────────────────────────────────────────────────────────────
# Railway sets PORT. Leave HOST unset (binds 0.0.0.0) unless you want Railway
# private networking, which is IPv6-only and needs HOST=::
HOST=
PORT=3000
