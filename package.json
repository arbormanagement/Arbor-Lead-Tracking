{
  "name": "arbor-lead-tracking",
  "version": "0.1.0",
  "private": true,
  "description": "Internal lead-tracking & ROI app for Arbor Management (WhatConverts-style): native Twilio call tracking + DNI, web/form capture, HousecallPro revenue, ad-spend ROI.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H ${HOST:-0.0.0.0}",
    "cron": "tsx scripts/cron.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "tsx scripts/migrate-deploy.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:backup": "tsx scripts/db-backup.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@t3-oss/env-nextjs": "^0.12.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.6",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.5",
    "twilio": "^5.4.2",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
