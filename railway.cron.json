{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "echo 'cron worker: no build step (tsx runs the scheduler from source)'"
  },
  "deploy": {
    "startCommand": "npm run cron",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
